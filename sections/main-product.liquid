{% assign v = product.selected_or_first_available_variant %}
<section class="product-page">
  <div class="product-page__grid">
    <div class="product-page__gallery">
      <div class="product-page__main-media">
        {% if product.featured_image %}
          <img id="ProductMainImage" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="800" height="800">
        {% else %}
          <div class="product-card__placeholder product-card__placeholder--lg">GLOW</div>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="product-page__thumbs">
          {% for image in product.images %}
            <button type="button" class="thumb{% if forloop.first %} is-active{% endif %}" data-src="{{ image | image_url: width: 1200 }}">
              <img src="{{ image | image_url: width: 160 }}" alt="" loading="lazy" width="72" height="72">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="product-page__info">
      <p class="product-page__eyebrow">Glow Case · Zelvira</p>
      <h1 class="product-page__title">{{ product.title }}</h1>
      <div class="product-page__price" id="ProductPrice">
        {% if v.compare_at_price > v.price %}
          <span class="price-compare">{{ v.compare_at_price | money_without_currency | strip }} ₽</span>
        {% endif %}
        <span class="price-current">{{ v.price | money_without_currency | strip }} ₽</span>
      </div>

      {% unless product.has_only_default_variant %}
        <div class="product-page__variants">
          {% for option in product.options_with_values %}
            <p class="label">{{ option.name }}</p>
            <div class="option-list" data-option-index="{{ forloop.index0 }}">
              {% for value in option.values %}
                <button type="button" class="option-pill{% if option.selected_value == value %} is-active{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
              {% endfor %}
            </div>
          {% endfor %}
        </div>
      {% endunless %}

      <form method="post" action="/cart/add" id="ProductForm" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" id="ProductVariantId" value="{{ v.id }}">
        <button type="submit" class="btn btn--primary btn--full" id="ProductBuyBtn" {% unless v.available %}disabled{% endunless %}>
          {% if v.available %}Купить · <span id="ProductBtnPrice">{{ v.price | money_without_currency | strip }} ₽</span>{% else %}Нет в наличии{% endif %}
        </button>
      </form>

      <ul class="product-page__bullets">
        <li>Светится после зарядки светом</li>
        <li>Защита от царапин и ударов</li>
        <li>Доставка по РФ 5–14 рабочих дней</li>
        <li>Вопросы: <a href="https://t.me/Abror0_0" target="_blank" rel="noopener">Telegram @Abror0_0</a></li>
      </ul>

      {% if product.description != blank %}
        <div class="product-page__description rte">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

<script type="application/json" id="ProductVariantsJson">{{ product.variants | json }}</script>
<script>
(function(){
  var el=document.getElementById('ProductVariantsJson'); if(!el) return;
  var variants=[]; try{variants=JSON.parse(el.textContent)}catch(e){return}
  function rub(n){n=Number(n); if(n>=10000 && n%100===0)n=n/100; return Math.round(n).toLocaleString('ru-RU')+' ₽'}
  function opts(){var o=[]; document.querySelectorAll('.product-page__variants .option-list').forEach(function(list){var a=list.querySelector('.option-pill.is-active'); o.push(a?a.getAttribute('data-value'):null)}); return o}
  function find(o){return variants.find(function(v){return v.options && v.options.every(function(x,i){return String(x)===String(o[i])})})}
  function apply(v){ if(!v) return; var id=document.getElementById('ProductVariantId'); var price=document.getElementById('ProductBtnPrice'); var main=document.querySelector('.price-current'); if(id)id.value=v.id; var t=rub(v.price); if(price)price.textContent=t; if(main)main.textContent=t; }
  document.querySelectorAll('.product-page__variants .option-pill').forEach(function(btn){
    btn.addEventListener('click', function(){
      var list=btn.closest('.option-list');
      list.querySelectorAll('.option-pill').forEach(function(b){b.classList.remove('is-active')});
      btn.classList.add('is-active');
      apply(find(opts()));
    });
  });
  document.querySelectorAll('.product-page__thumbs .thumb').forEach(function(btn){
    btn.addEventListener('click', function(){
      var m=document.getElementById('ProductMainImage'); if(m) m.src=btn.getAttribute('data-src');
      btn.parentNode.querySelectorAll('.thumb').forEach(function(t){t.classList.remove('is-active')});
      btn.classList.add('is-active');
    });
  });
})();
</script>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "templates": ["product"]
}
{% endschema %}
