<section class="hero">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__content">
    <p class="hero__kicker">Zelvira · Glow Cases</p>
    <h1 class="hero__title">{{ section.settings.heading }}</h1>
    <p class="hero__sub">{{ section.settings.subheading }}</p>
    {% if section.settings.button_label != blank %}
      <a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "MAKE THEM GLOW" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Светящиеся чехлы для AirPods и iPhone." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Смотреть коллекцию" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
